<?xml version="1.0"?>
<sdf version="1.10">
  <model name="mecanum_car">
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.1264</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.3363</iyy>
          <iyz>0</iyz>
          <izz>0.4443</izz>
        </inertia>
      </inertial>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.70 0.42 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.22 0.82 1</ambient>
          <diffuse>0.10 0.22 0.82 1</diffuse>
        </material>
      </visual>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.70 0.42 0.12</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="imu_link">
      <pose relative_to="base_link">0.12 0 0.075 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000054</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000083</iyy>
          <iyz>0</iyz>
          <izz>0.0000104</izz>
        </inertia>
      </inertial>
      <visual name="imu_visual">
        <geometry>
          <box>
            <size>0.04 0.03 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.58 0.60 1</ambient>
          <diffuse>0.55 0.58 0.60 1</diffuse>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/four_wheel_car/imu_gz</topic>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>


  <link name="lidar_link">
      <pose relative_to="base_link">0.25 0 0.15 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/scan_gz</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>10.0</max>
          </range>
        </lidar>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>


    <link name="front_left_wheel_link">
      <pose>0.28 0.23 0.10 0 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.00117</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00225</iyy>
          <iyz>0</iyz>
          <izz>0.00117</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.035 1</ambient>
          <diffuse>0.03 0.03 0.035 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="front_right_wheel_link">
      <pose>0.28 -0.23 0.10 0 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.00117</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00225</iyy>
          <iyz>0</iyz>
          <izz>0.00117</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.035 1</ambient>
          <diffuse>0.03 0.03 0.035 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rear_left_wheel_link">
      <pose>-0.28 0.23 0.10 0 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.00117</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00225</iyy>
          <iyz>0</iyz>
          <izz>0.00117</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.035 1</ambient>
          <diffuse>0.03 0.03 0.035 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rear_right_wheel_link">
      <pose>-0.28 -0.23 0.10 0 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.00117</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00225</iyy>
          <iyz>0</iyz>
          <izz>0.00117</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.035 1</ambient>
          <diffuse>0.03 0.03 0.035 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent> <child>front_left_wheel_link</child>
      <pose relative_to="base_link">0.28 0.23 -0.06 0 0 0</pose> 
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>30.0</effort>
          <velocity>80.0</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent> <child>front_right_wheel_link</child>
      <pose relative_to="base_link">0.28 -0.23 -0.06 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>30.0</effort>
          <velocity>80.0</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel_link</child>
      <pose relative_to="base_link">-0.28 0.23 -0.06 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>30.0</effort>
          <velocity>80.0</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel_link</child>
      <pose relative_to="base_link">-0.28 -0.23 -0.06 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>30.0</effort>
          <velocity>80.0</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states_gz</topic> 
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>

    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
