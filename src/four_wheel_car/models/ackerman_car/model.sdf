      <parent>front_left_steer_link</parent>
      <child>front_left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>12.0</effort>
          <velocity>80.0</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
