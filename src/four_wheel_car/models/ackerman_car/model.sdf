      <pose>0.28 0.23 0.10 0 0 0</pose>
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.00117</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00225</iyy>
          <iyz>0</iyz>
          <izz>0.00117</izz>
        </inertia>
