    <plugin filename="libfour_wheel_car_system.so" name="four_wheel_car::FourWheelCarSystem">
      <cmd_vel_topic>/cmd_vel</cmd_vel_topic>
      <odom_topic>/odom</odom_topic>
      <imu_topic>/imu/data</imu_topic>
      <joint_state_topic>/joint_states</joint_state_topic>
      <marker_topic>/com_trajectory_marker</marker_topic>
      <base_link>base_link</base_link>
      <odom_child_frame>base_footprint</odom_child_frame>
      <front_left_steer_joint>front_left_steer_joint</front_left_steer_joint>
      <front_right_steer_joint>front_right_steer_joint</front_right_steer_joint>
      <front_left_wheel_joint>front_left_wheel_joint</front_left_wheel_joint>
      <front_right_wheel_joint>front_right_wheel_joint</front_right_wheel_joint>
      <rear_left_wheel_joint>rear_left_wheel_joint</rear_left_wheel_joint>
      <rear_right_wheel_joint>rear_right_wheel_joint</rear_right_wheel_joint>
      <wheel_radius>0.10</wheel_radius>
      <front_x>0.28</front_x>
      <front_left_y>0.23</front_left_y>
      <front_right_y>-0.23</front_right_y>
      <steer_limit>0.75</steer_limit>
      <drive_speed_limit>45.0</drive_speed_limit>
      <steer_kp>45.0</steer_kp>
      <steer_kd>4.5</steer_kd>
      <drive_kp>1.8</drive_kp>
      <drive_kd>0.35</drive_kd>
      <max_steer_torque>35.0</max_steer_torque>
      <max_drive_torque>12.0</max_drive_torque>
    </plugin>
