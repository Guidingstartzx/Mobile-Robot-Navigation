    <joint name="front_left_steer_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_steer_link</child>
      <pose relative_to="base_link">0.28 0.23 -0.06 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.75</lower>
          <upper>0.75</upper>
          <effort>35.0</effort>
          <velocity>8.0</velocity>
        </limit>
        <dynamics>
          <damping>0.08</damping>
          <friction>0.02</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="front_right_steer_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_steer_link</child>
      <pose relative_to="base_link">0.28 -0.23 -0.06 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.75</lower>
          <upper>0.75</upper>
          <effort>35.0</effort>
          <velocity>8.0</velocity>
        </limit>
        <dynamics>
          <damping>0.08</damping>
          <friction>0.02</friction>
        </dynamics>
      </axis>
    </joint>

