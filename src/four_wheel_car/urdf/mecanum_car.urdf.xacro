<?xml version="1.0"?>
<robot name="four_wheel_car" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.70"/>
  <xacro:property name="base_width" value="0.42"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.055"/>
  <xacro:property name="wheelbase" value="0.56"/>
  <xacro:property name="track" value="0.46"/>
  <xacro:property name="front_x" value="${wheelbase * 0.5}"/>
  <xacro:property name="rear_x" value="${-wheelbase * 0.5}"/>
  <xacro:property name="left_y" value="${track * 0.5}"/>
  <xacro:property name="right_y" value="${-track * 0.5}"/>
  <xacro:property name="wheel_z" value="${-(base_height * 0.5)}"/>

  <material name="body_blue">
    <color rgba="0.10 0.22 0.82 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.03 0.03 0.035 1.0"/>
  </material>
  <material name="metal_grey">
    <color rgba="0.55 0.58 0.60 1.0"/>
  </material>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="mass radius width">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + width * width) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.5 * mass * radius * radius}"
        iyz="0.0"
        izz="${mass * (3.0 * radius * radius + width * width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <xacro:wheel_inertia mass="0.45" radius="${wheel_radius}" width="${wheel_width}"/>
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:box_inertia mass="8.0" x="${base_length}" y="${base_width}" z="${base_height}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="imu_link">
    <xacro:box_inertia mass="0.05" x="0.04" y="0.03" z="0.02"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.02"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.12 0 0.075" rpy="0 0 0"/>
  </joint>


  <xacro:wheel_link name="front_left_wheel_link"/>
  <xacro:wheel_link name="front_right_wheel_link"/>
  <xacro:wheel_link name="rear_left_wheel_link"/>
  <xacro:wheel_link name="rear_right_wheel_link"/>

<joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>  <child link="front_left_wheel_link"/>
    <origin xyz="${front_x} ${left_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="12.0" velocity="80.0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>  <child link="front_right_wheel_link"/>
    <origin xyz="${front_x} ${right_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="12.0" velocity="80.0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="${rear_x} ${left_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.0" velocity="80.0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="${rear_x} ${right_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.0" velocity="80.0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/four_wheel_car/imu_gz</topic>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="libfour_wheel_car_system.so" name="four_wheel_car::FourWheelCarSystem">
      <cmd_vel_topic>/cmd_vel</cmd_vel_topic>
      <odom_topic>/odom</odom_topic>
      <imu_topic>/imu/data</imu_topic>
      <joint_state_topic>/joint_states</joint_state_topic>
      <marker_topic>/com_trajectory_marker</marker_topic>
      <base_link>base_link</base_link>
      <odom_child_frame>base_footprint</odom_child_frame>
      <front_left_steer_joint>front_left_steer_joint</front_left_steer_joint>
      <front_right_steer_joint>front_right_steer_joint</front_right_steer_joint>
      <front_left_wheel_joint>front_left_wheel_joint</front_left_wheel_joint>
      <front_right_wheel_joint>front_right_wheel_joint</front_right_wheel_joint>
      <rear_left_wheel_joint>rear_left_wheel_joint</rear_left_wheel_joint>
      <rear_right_wheel_joint>rear_right_wheel_joint</rear_right_wheel_joint>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <front_x>${front_x}</front_x>
      <front_left_y>${left_y}</front_left_y>
      <front_right_y>${right_y}</front_right_y>
      <steer_limit>0.75</steer_limit>
      <drive_speed_limit>45.0</drive_speed_limit>
      <steer_kp>45.0</steer_kp>
      <steer_kd>4.5</steer_kd>
      <drive_kp>1.8</drive_kp>
      <drive_kd>0.35</drive_kd>
      <max_steer_torque>35.0</max_steer_torque>
      <max_drive_torque>12.0</max_drive_torque>
    </plugin>
  </gazebo>


  <!-- LIDAR sensor -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.25 0 0.15" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/scan_gz</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
